# ===================================================================
# SOLAR & WIND DEPLOYMENT INTELLIGENCE PLATFORM - ENVIRONMENT TEMPLATE
# Placeholders only — copy to .env and supply actual credentials.
# ===================================================================

# Database Configuration (PostgreSQL 15 + PostGIS 3)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=solar_wind_db

# Security & JWT Authentication
SECRET_KEY=YOUR_SECURE_RANDOM_64_CHAR_JWT_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Satellite & GIS APIs
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Backend CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173"]

# Frontend Application Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
